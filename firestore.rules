rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    // A claim é definida por um administrador com o Admin SDK, nunca pelo cliente.
    function admin() { return autenticado() && request.auth.token.admin == true; }
    function dono(uid) { return autenticado() && request.auth.uid == uid; }
    function statusValido(status) {
      return status in ['pendente', 'preparando', 'pronto', 'entregue', 'cancelado'];
    }
    function pedidoValido() {
      let p = request.resource.data;
      return p.keys().hasAll(['uid', 'email', 'itens', 'total', 'quantidadeTotal', 'status', 'criadoEm'])
        && p.keys().hasOnly(['uid', 'email', 'itens', 'total', 'quantidadeTotal', 'status', 'criadoEm', 'observacao'])
        && dono(p.uid)
        && p.email == request.auth.token.email
        && p.status == 'pendente'
        && p.criadoEm == request.time
        && p.itens is list && p.itens.size() > 0 && p.itens.size() <= 100
        && p.total is number && p.total > 0 && p.total <= 100000
        && p.quantidadeTotal is int && p.quantidadeTotal > 0 && p.quantidadeTotal <= 10000
        && (!('observacao' in p) || (p.observacao is string && p.observacao.size() <= 500));
    }
    function perfilValido() {
      let p = request.resource.data;
      return p.keys().hasAll(['nome', 'email', 'telefone', 'criadoEm'])
        && p.keys().hasOnly(['nome', 'email', 'telefone', 'criadoEm'])
        && p.nome is string && p.nome.size() > 0 && p.nome.size() <= 120
        && p.email == request.auth.token.email
        && p.telefone is string && p.telefone.size() > 0 && p.telefone.size() <= 30
        && p.criadoEm == request.time;
    }
    match /produtos/{id} {
      allow read: if autenticado();
      allow write: if admin();
    }
    match /pedidos/{id} {
      allow create: if pedidoValido();
      allow read: if dono(resource.data.uid) || admin();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && statusValido(request.resource.data.status);
      allow delete: if false;
    }
    match /usuarios/{uid} {
      allow read: if dono(uid);
      allow create, update: if dono(uid) && perfilValido();
      allow delete: if false;
    }
  }
}
